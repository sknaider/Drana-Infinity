# Drana-Infinity GTL Edition - Environment Configuration Template
# Copy this file to .env and configure with your actual values

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
DRANA_ENV=development  # Options: development, staging, production

# ============================================================================
# AI MODEL CONFIGURATION
# ============================================================================

# --- Ollama (Local AI) ---
OLLAMA_ENABLED=true
OLLAMA_MODEL=IHA089/drana-infinity-v1
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=120

# --- Anthropic Claude ---
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_ENDPOINT=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLAUDE_MAX_TOKENS=8192
CLAUDE_TEMPERATURE=0.5
CLAUDE_TIMEOUT=180

# --- DeepSeek-R1 (Medical AI Security) ---
DEEPSEEK_ENABLED=false  # Enable for medical AI security features
DEEPSEEK_MODEL=deepseek-r1
DEEPSEEK_ENDPOINT=http://localhost:8000
DEEPSEEK_API_KEY=  # Optional, if using hosted service
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_TIMEOUT=180

# ============================================================================
# GPU CONFIGURATION (RTX 5090)
# ============================================================================
GPU_DEVICE_ID=0
GPU_MAX_VRAM_GB=24  # Leave 8GB for medical AI workloads
GPU_CONCURRENT_WORKLOADS=4
GPU_MIXED_PRECISION=true
GPU_TENSOR_CORES=true
GPU_COMPUTE_CAPABILITY=sm_120
GPU_MONITOR_INTERVAL=30  # seconds

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database Type: postgresql (production), sqlite (development)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drana_gtl
DB_USERNAME=drana_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_SSL_MODE=require  # Options: require, disable (use 'require' for production)

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_RANDOM_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# Authentication & Access Control
ENABLE_MFA=true  # Strongly recommended for production
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
TLS_VERSION=1.3

# Audit & Logging
ENABLE_AUDIT_LOGGING=true
PHI_DETECTION_ENABLED=true  # Prevent PHI in logs (HIPAA compliance)

# ============================================================================
# COMPLIANCE CONFIGURATION
# ============================================================================

# Enabled Frameworks: HIPAA, ISO27001, NIST_CSF, SUNAT_PERU, LEY_29733_PERU
COMPLIANCE_FRAMEWORKS=HIPAA,ISO27001,NIST_CSF
COMPLIANCE_ENFORCEMENT=warn  # Options: audit_only, warn, enforce
AUDIT_RETENTION_YEARS=6  # HIPAA requires 6 years minimum
AUTO_REMEDIATION=false  # Enable automated remediation (use with caution)
COMPLIANCE_SCAN_INTERVAL=24  # hours
COMPLIANCE_REPORTS_ENABLED=true

# ============================================================================
# THREAT INTELLIGENCE CONFIGURATION
# ============================================================================

# Threat Feeds
ENABLE_CISA_FEED=true
ENABLE_FDA_FEED=true  # Medical device security alerts
ENABLE_NVD_FEED=true  # CVE database
ENABLE_MITRE_ATTACK=true  # ATT&CK framework

# Threat Intelligence Settings
THREAT_INTEL_UPDATE_INTERVAL=6  # hours
IOC_RETENTION_DAYS=90
THREAT_SCORE_THRESHOLD=0.7  # 0.0-1.0, higher = fewer false positives

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8443  # Use 8443 for HTTPS
API_WORKERS=4
API_RELOAD=false  # Set true only for development
API_LOG_LEVEL=info  # Options: debug, info, warning, error, critical

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=https://localhost,https://gtl-platform.com
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# VULNERABILITY SCANNING
# ============================================================================

# Scanning Tools
NMAP_ENABLED=true
NMAP_PATH=/usr/bin/nmap
NUCLEI_ENABLED=true
NUCLEI_PATH=/usr/local/bin/nuclei
NUCLEI_TEMPLATES_PATH=/home/user/nuclei-templates

# Scan Configuration
SCAN_CONCURRENCY=5
SCAN_TIMEOUT_MINUTES=30
SCAN_SCHEDULE_CRON=0 2 * * *  # Daily at 2 AM

# ============================================================================
# PENETRATION TESTING
# ============================================================================

PENTEST_ENABLED=false  # Enable only when authorized
PENTEST_SAFE_MODE=true  # Prevents destructive tests
PENTEST_TARGET_NETWORKS=10.0.0.0/24,192.168.1.0/24
PENTEST_EXCLUDED_IPS=10.0.0.1,192.168.1.1  # Exclude critical infrastructure

# ============================================================================
# REPORTING CONFIGURATION
# ============================================================================

# Report Generation
REPORTS_OUTPUT_DIR=/var/reports/drana-gtl
REPORTS_FORMATS=pdf,docx,json  # Supported: pdf, docx, json, csv
REPORTS_RETENTION_DAYS=365

# GTL Branding
GTL_COMPANY_NAME=GTL Consulting
GTL_LOGO_PATH=/home/user/Drana-Infinity/assets/gtl-logo.png
GTL_CONTACT_EMAIL=security@gtl-consulting.com
GTL_WEBSITE=https://gtl-consulting.com

# ============================================================================
# DASHBOARD & WEBSOCKET
# ============================================================================

WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8765
DASHBOARD_UPDATE_INTERVAL=5  # seconds
DASHBOARD_METRICS_RETENTION=7  # days

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text
LOG_FILE=/var/log/drana-gtl/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# ELK Stack Integration (Optional)
ELK_ENABLED=false
ELK_ENDPOINT=http://localhost:9200
ELK_INDEX=drana-gtl-logs
ELK_USERNAME=elastic
ELK_PASSWORD=CHANGE_ME

# Prometheus Metrics (Optional)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ============================================================================
# GTL PLATFORM INTEGRATION
# ============================================================================

GTL_PLATFORM_ENABLED=false  # Enable when integrating with GTL ecosystem
GTL_PLATFORM_ENDPOINT=https://platform.gtl-consulting.com/api
GTL_PLATFORM_API_KEY=CHANGE_ME
GTL_PLATFORM_SYNC_INTERVAL=3600  # seconds (1 hour)

# ============================================================================
# SECTOR-SPECIFIC CONFIGURATION
# ============================================================================

# Target Sectors: LOGISTICS, MEDICAL_AI, GENERAL
PRIMARY_SECTOR=LOGISTICS  # or MEDICAL_AI
SECONDARY_SECTORS=GENERAL

# Logistics-Specific
SUNAT_COMPLIANCE_ENABLED=true
EDI_SECURITY_ENABLED=true
CUSTOMS_API_MONITORING=true

# Medical AI-Specific
FDA_GUIDANCE_COMPLIANCE=false
PHI_ENCRYPTION_ENFORCED=true
ADVERSARIAL_ML_DETECTION=false

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE_CRON=0 3 * * *  # Daily at 3 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=/backups/drana-gtl  # or s3://bucket-name/drana-gtl
BACKUP_ENCRYPTION=true

# Recovery Objectives
RTO_HOURS=4  # Recovery Time Objective
RPO_HOURS=1  # Recovery Point Objective

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

# Email Notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@gtl-consulting.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Drana-GTL <noreply@gtl-consulting.com>
SMTP_TLS=true

# Alert Recipients
ALERT_RECIPIENTS_CRITICAL=security-team@gtl-consulting.com
ALERT_RECIPIENTS_HIGH=security-team@gtl-consulting.com,ops@gtl-consulting.com
ALERT_RECIPIENTS_MEDIUM=ops@gtl-consulting.com

# Slack Integration (Optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Development Mode Settings (DO NOT USE IN PRODUCTION)
DEBUG_MODE=false
MOCK_AI_RESPONSES=false  # Use mock responses for testing without API costs
DISABLE_AUTH=false  # DANGEROUS: Only for local development
SEED_TEST_DATA=false  # Populate with test data

# Testing Configuration
TEST_DATABASE_URL=sqlite:///test_drana_gtl.db
PYTEST_COVERAGE_THRESHOLD=85  # Minimum code coverage percentage

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Caching
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# Connection Pooling
HTTP_POOL_SIZE=50
HTTP_POOL_MAXSIZE=100
HTTP_TIMEOUT=30

# Concurrency
MAX_CONCURRENT_REQUESTS=100
MAX_CONCURRENT_AI_CALLS=10
REQUEST_QUEUE_SIZE=500

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable specific features
FEATURE_COMPLIANCE_ENGINE=true
FEATURE_THREAT_INTEL=true
FEATURE_VULNERABILITY_SCANNING=true
FEATURE_PENETRATION_TESTING=false  # Requires explicit authorization
FEATURE_AI_ORCHESTRATION=true
FEATURE_MULTI_MODEL=true
FEATURE_GPU_OPTIMIZATION=true
FEATURE_REPORTING=true
FEATURE_DASHBOARD=true
FEATURE_WEBSOCKET=true

# ============================================================================
# LEGAL & COMPLIANCE NOTICES
# ============================================================================

# Terms Acceptance
TERMS_ACCEPTED=false  # Must set to 'true' to use the system
DATA_RETENTION_POLICY_URL=https://gtl-consulting.com/data-retention
PRIVACY_POLICY_URL=https://gtl-consulting.com/privacy
TERMS_OF_SERVICE_URL=https://gtl-consulting.com/terms

# License
LICENSE_KEY=  # Enterprise license key (contact GTL Consulting)
LICENSE_EXPIRY=  # Format: YYYY-MM-DD

# ============================================================================
# NOTES
# ============================================================================
#
# - Generate strong random values for secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# - For production deployment:
#   1. Change ALL default passwords and secrets
#   2. Set DRANA_ENV=production
#   3. Enable MFA (ENABLE_MFA=true)
#   4. Use PostgreSQL instead of SQLite
#   5. Enable TLS/HTTPS
#   6. Configure proper backup storage
#   7. Review and adjust all security settings
#
# - For HIPAA compliance:
#   1. Ensure AUDIT_RETENTION_YEARS=6 (minimum)
#   2. Enable PHI_DETECTION_ENABLED=true
#   3. Enable ENABLE_AUDIT_LOGGING=true
#   4. Configure proper encryption
#   5. Enable MFA for all users
#
# - Contact: support@gtl-consulting.com for enterprise support
# ============================================================================
