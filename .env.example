# Drana-Infinity Configuration
# Copy this file to .env and update the values

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-characters
FLASK_ENV=production
DEBUG=False

# Server Configuration
HOST=127.0.0.1
PORT=80
USE_HTTPS=False

# Database Configuration
DATABASE_NAME=chat_database.db

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,csv,json,xml,log,md,py,js,html,css

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Security Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_UPLOAD=10 per hour
RATELIMIT_COMMAND=30 per hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=drana_infinity.log
